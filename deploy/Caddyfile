# HTTPS reverse proxy for CoralGPT / Privy
# Tailscale: https://vps2.tail7b9cd0.ts.net:8443
# Local Privy (HTTP): http://127.0.0.1:3000

{
	auto_https disable_redirects
}

vps2.tail7b9cd0.ts.net {
	tls internal
	reverse_proxy bioagents:3000
}

# Fallback for direct IP / other hostnames on :443
:443 {
	tls internal
	reverse_proxy bioagents:3000
}
