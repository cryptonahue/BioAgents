# ============================================================================
# BioAgents / CoralGPT - Variables de entorno para COOLIFY
# ============================================================================
#
# Pegá estas variables en Coolify -> tu aplicación -> Environment Variables.
#
# >>> LEER ESTO PRIMERO <<<
# Hay 4 variables que se HORNEAN en el bundle del navegador durante el build.
# En Coolify tenés que marcarlas como "Build Variable / Available at buildtime":
#     SUPABASE_URL
#     SUPABASE_ANON_KEY
#     PRIVY_APP_ID
#     CORALGPT_HERO_VIDEO_URL   (opcional)
# Si no las marcás como build-time, la app carga en negro (Loading...) porque
# el cliente queda con valores vacíos. El resto son variables de runtime.
# ============================================================================


# ----------------------------------------------------------------------------
# Dominio / CORS  (poné el dominio que asignás en Coolify)
# ----------------------------------------------------------------------------
NODE_ENV=production
# Lista separada por comas con el/los origen(es) permitidos. DEBE incluir tu dominio.
ALLOWED_ORIGINS=https://tu-dominio.com
MAX_JWT_EXPIRATION=3600

# Puerto interno del servidor (en Coolify "Ports Exposes" = 3000)
PORT=3000


# ----------------------------------------------------------------------------
# Supabase  (URL y ANON KEY -> marcar como BUILD VARIABLE en Coolify)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role key: operaciones de backend (bypassa RLS). Solo runtime.
SUPABASE_SERVICE_KEY=
# Connection string de Postgres, solo para correr migraciones.
SUPABASE_FULL_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres


# ----------------------------------------------------------------------------
# CoralGPT / Privy  (PRIVY_APP_ID -> marcar como BUILD VARIABLE en Coolify)
# ----------------------------------------------------------------------------
# Con PRIVY_APP_ID + PRIVY_APP_SECRET activos, la UI entra en modo CoralGPT
# (landing pública, login con Privy, acceso por whitelist).
# IMPORTANTE: en el dashboard de Privy agregá tu dominio (https://tu-dominio.com)
# en Allowed origins / Redirect URLs.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Video opcional del hero de la landing (build-time, opcional).
CORALGPT_HERO_VIDEO_URL=


# ----------------------------------------------------------------------------
# Autenticación
# ----------------------------------------------------------------------------
# Generar con: openssl rand -hex 32
BIOAGENTS_SECRET=cambiar-por-un-string-aleatorio-seguro
# 'none' (sin auth) o 'jwt' (requiere tokens firmados con BIOAGENTS_SECRET)
AUTH_MODE=none
# Password opcional para proteger la UI (modo dev). Dejar vacío para desactivar.
# UI_PASSWORD=


# ----------------------------------------------------------------------------
# Proveedores de LLM  (al menos uno es obligatorio)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# Modelos por agente (provider: openai | anthropic | google | openrouter)
REPLY_LLM_PROVIDER=openai
REPLY_LLM_MODEL=gpt-5.4
HYP_LLM_PROVIDER=openai
HYP_LLM_MODEL=gpt-5.4
PLANNING_LLM_PROVIDER=openai
PLANNING_LLM_MODEL=gpt-5.4
STRUCTURED_LLM_PROVIDER=openai
STRUCTURED_LLM_MODEL=gpt-5.4

# Agente de chat (usa el SDK de Anthropic directamente)
CHAT_AGENT_MODEL=claude-sonnet-4-6
CHAT_AGENT_MAX_TOOL_CALLS=10
CHAT_AGENT_MAX_TOKENS=4096
CHAT_TOOL_TIMEOUT_MS=30000

# Loop de research autónomo
CONTINUE_RESEARCH_LLM_PROVIDER=anthropic
CONTINUE_RESEARCH_LLM_MODEL=claude-sonnet-4-5-20250929
MAX_AUTO_ITERATIONS=5


# ----------------------------------------------------------------------------
# Embeddings / RAG
# ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
TEXT_EMBEDDING_MODEL=text-embedding-3-large
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
VECTOR_SEARCH_LIMIT=20
RERANK_FINAL_LIMIT=5
USE_RERANKING=true
SIMILARITY_THRESHOLD=0.75
RERANKER_SCORE_THRESHOLD=0.3
# Carpeta de documentos de conocimiento que se ingestan al arrancar.
KNOWLEDGE_DOCS_PATH=docs


# ----------------------------------------------------------------------------
# Cola de trabajos (BullMQ + Redis)
# ----------------------------------------------------------------------------
# false = ejecución en proceso (sin Redis). true = usar cola con Redis.
USE_JOB_QUEUE=false
# Si USE_JOB_QUEUE=true: agregá un recurso Redis en Coolify y apuntá acá.
# Ej (Redis interno de Coolify): redis://<nombre-del-servicio>:6379
REDIS_URL=redis://localhost:6379
CHAT_QUEUE_CONCURRENCY=5
DEEP_RESEARCH_QUEUE_CONCURRENCY=3
PAPER_GENERATION_CONCURRENCY=1
MAX_CONCURRENT_PAPER_JOBS=3
CHAT_RATE_LIMIT_PER_MINUTE=10
DEEP_RESEARCH_RATE_LIMIT_PER_5MIN=3
# Dashboard de la cola (Bull Board). Password obligatorio en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


# ----------------------------------------------------------------------------
# Identidad del agente / SEO  (opcional)
# ----------------------------------------------------------------------------
CHARACTER_FILE=characters/bios.json
# AGENT_NAME=BIOS
# AGENT_EMAIL=bios@bio.xyz
SEO_TITLE=
SEO_DESCRIPTION=
FAVICON_URL=
OG_IMAGE_URL=


# ----------------------------------------------------------------------------
# Almacenamiento de archivos (S3)  (opcional)
# ----------------------------------------------------------------------------
# 's3' para habilitar; vacío = deshabilitado.
STORAGE_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# Endpoint custom (MinIO, DO Spaces, etc.) opcional.
S3_ENDPOINT=


# ----------------------------------------------------------------------------
# Pagos x402 / b402 (opcional, off por defecto)
# ----------------------------------------------------------------------------
X402_ENABLED=false
B402_ENABLED=false
# Coinbase Developer Platform (CDP_PROJECT_ID se hornea en el cliente si usás x402)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_PROJECT_ID=
